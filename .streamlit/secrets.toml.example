# Copia este archivo como 'secrets.toml' y rellena con tus valores reales
# NUNCA subas secrets.toml a Git (ya está en .gitignore)

[supabase]
url = "https://TU-PROYECTO.supabase.co"
anon_key = "tu-anon-key-aqui"
# La service_role solo se usa en operaciones administrativas del servidor
service_key = "tu-service-role-key-aqui"

[app]
# Modo de autenticación: 'supabase' (producción) o 'local' (solo desarrollo)
auth_mode = "supabase"
# Tiempo en minutos antes de cerrar sesión por inactividad
session_timeout_minutes = 60
